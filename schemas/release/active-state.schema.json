{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "active-state.schema.json",
  "type": "object",
  "required": [
    "workspace_id",
    "state_id",
    "local_revision",
    "state_manifest_hash"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "state_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "local_revision": {
      "type": "integer",
      "minimum": 0
    },
    "state_manifest_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    }
  },
  "additionalProperties": false
}
